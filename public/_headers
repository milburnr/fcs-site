# No Early Hints hero preload — the <link rel="preload" imageSrcSet> in HTML handles it.
# Early Hints was preloading small.webp while srcset picks medium/large, causing double download.

# Long-lived cache for hashed static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Hero images served directly from Netlify CDN
/hero/*
  Cache-Control: public, max-age=31536000, immutable

# Proxied R2 images - tell Netlify edge to cache them
/images/*
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, immutable, durable

/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable
  Netlify-CDN-Cache-Control: public, max-age=31536000, immutable, durable
